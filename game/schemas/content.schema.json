{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content.schema.json",
  "title": "Monster Mash content (balance and entities)",
  "description": "Numbers live here, behaviour lives in code registries keyed by id. Keys starting with _ are comments. Add a new field here before using it in data. See architecture/DATA.md.",
  "type": "object",
  "required": ["tuning", "damageRules", "weapons", "monsters", "materials", "realms", "arena"],
  "patternProperties": { "^_": {} },
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "builder": { "$ref": "#/$defs/builder" },
    "tuning": { "$ref": "#/$defs/tuning" },
    "damageRules": { "$ref": "#/$defs/damageRules" },
    "economy": { "$ref": "#/$defs/economy" },
    "weapons": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/weapon" } },
    "stretchWeapons": { "type": "array", "items": { "$ref": "#/$defs/weaponStub" } },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "stretchArtifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "consumables": { "type": "array", "items": { "$ref": "#/$defs/consumable" } },
    "monsters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/monster" } },
    "materials": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/material" } },
    "realms": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/realm" } },
    "cosmetics": { "type": "array", "items": { "$ref": "#/$defs/cosmetic" } },
    "arena": { "$ref": "#/$defs/arena" }
  },
  "$defs": {
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid",
        "worldW",
        "groundY",
        "minX",
        "minY",
        "maxBlocks",
        "maxConnections",
        "maxMonsters",
        "materials",
        "targets",
        "loadout",
        "physics",
        "presets"
      ],
      "properties": {
        "grid": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "worldW": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "groundY": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "minX": {
          "type": "number"
        },
        "minY": {
          "type": "number"
        },
        "maxBlocks": {
          "type": "integer",
          "minimum": 1
        },
        "maxConnections": {
          "type": "integer",
          "minimum": 1
        },
        "maxMonsters": {
          "type": "integer",
          "minimum": 1
        },
        "materials": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "loadout": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lockStiffness",
            "lockSpan",
            "ropeStiffness",
            "ropeDamping"
          ],
          "properties": {
            "lockStiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "lockSpan": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ropeStiffness": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            },
            "ropeDamping": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "presets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "w",
              "h",
              "shape",
              "family"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "family": { "enum": ["Planks", "Square", "Circle", "Wedge"] },
              "variant": { "enum": ["hollow", "wheel", "wheel_plank", "wheel_wedge"] },
              "w": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "h": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "shape": {
                "enum": [
                  "rectangle",
                  "circle",
                  "triangle"
                ]
              }
            }
          }
        }
      }
    },
    "element": { "enum": ["physical", "hellfire", "radiant", "void"] },
    "elementOrNull": { "enum": ["physical", "hellfire", "radiant", "void", null] },
    "rarity": { "enum": ["common", "uncommon", "rare", "epic", "legendary", "mythic"] },
    "params": {
      "description": "Per-item numbers read by the item's behaviour code (durations in steps at 60 Hz, distances in world px).",
      "type": "object",
      "additionalProperties": { "type": ["number", "string", "boolean"] }
    },
    "tuning": {
      "type": "object",
      "required": ["launchK", "maxPull", "debrisK", "hitStopFrames", "coins"],
      "patternProperties": { "^_": {} },
      "additionalProperties": { "type": ["number", "object"] },
      "properties": {
        "launchK": { "type": "number", "exclusiveMinimum": 0, "maximum": 2, "description": "Pull px to launch px/step." },
        "maxPull": { "type": "number", "minimum": 5, "maximum": 120 },
        "debrisK": { "type": "number", "minimum": 0 },
        "hitStopFrames": { "type": "integer", "minimum": 0, "maximum": 20 },
        "stretchSoundMs": { "type": "number", "minimum": 0 },
        "homeZoomMin": { "type": "number", "minimum": 0.1, "maximum": 2 },
        "homeLeft": { "type": "number" },
        "homeMarginRight": { "type": "number", "minimum": 0 },
        "homeSlingFrac": { "type": "number", "minimum": 0.1, "maximum": 0.5 },
        "chestHp": { "type": "number", "minimum": 1, "description": "Default HP for breakable treasure chests." },
        "coins": {
          "type": "object",
          "additionalProperties": { "type": "number", "minimum": 0 },
          "description": "Coins per kill, keyed by monster or material id, or 'monster' as the fallback for monsters."
        }
      }
    },
    "damageRules": {
      "type": "object",
      "required": ["globalScale", "elementWeak", "elementResist", "upgradeDamagePerStep", "upgradeCostMultiplier", "maxUpgradeLevel", "comboWindowSeconds", "comboMultipliers"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "globalScale": { "type": "number", "exclusiveMinimum": 0 },
        "elementWeak": { "type": "number", "minimum": 1 },
        "elementResist": { "type": "number", "minimum": 0, "maximum": 1 },
        "upgradeDamagePerStep": { "type": "number", "minimum": 0 },
        "upgradeCostMultiplier": { "type": "number", "minimum": 1 },
        "upgradeBaseCost": { "type": "number", "minimum": 0 },
        "forgeRarityMultiplier": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "maxUpgradeLevel": { "type": "integer", "minimum": 0, "maximum": 20 },
        "impactFactorMin": { "type": "number", "minimum": 0 },
        "impactFactorMax": { "type": "number", "minimum": 0 },
        "comboWindowSeconds": { "type": "number", "exclusiveMinimum": 0 },
        "comboMultipliers": { "type": "array", "minItems": 1, "items": { "type": "number", "minimum": 0 } }
      }
    },
    "economy": {
      "type": "object",
      "patternProperties": { "^_": {} },
      "additionalProperties": { "type": ["number", "object", "array"] },
      "properties": {
        "leftoverShotCoins": { "type": "number", "minimum": 0 },
        "starScoreFactor": { "type": "number", "minimum": 0 },
        "dailyStreakRewardDay": { "type": "integer", "minimum": 1 },
        "dailyStreakRewardCoins": { "type": "number", "minimum": 0 },
        "relicPityLosses": { "type": "integer", "minimum": 1, "description": "Boss losses required to unlock boss relic in relic market." },
        "relicMarketPrice": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } },
        "ads": {
          "type": "object", "additionalProperties": false,
          "required": ["coinReward", "perWindow", "windowHours", "extraShots"],
          "properties": {
            "coinReward": { "type": "number", "minimum": 0 },
            "perWindow": { "type": "integer", "minimum": 0 },
            "windowHours": { "type": "number", "minimum": 0.1 },
            "extraShots": { "type": "integer", "minimum": 1, "maximum": 6 },
            "bonusDamage": { "type": "number", "minimum": 0, "maximum": 1, "description": "Extra damage on the shots an ad grants, shown to the player (0.25 = 25 percent)." },
            "interstitialEvery": { "type": "integer", "minimum": 0, "description": "Show a full-screen ad after every N finished battles (0 = never). Only where the platform has interstitials (the Android app)." },
            "interstitialFromLevel": { "type": "integer", "minimum": 1, "description": "No interstitials before this level, so new players are never interrupted." }
          }
        }
      }
    },
    "weapon": {
      "type": "object",
      "required": ["id", "name", "archetype", "element", "baseDamage"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^w_[a-z0-9_]+$" },
        "name": { "type": "string", "minLength": 1 },
        "archetype": { "type": "string" },
        "element": { "$ref": "#/$defs/element" },
        "rarity": { "$ref": "#/$defs/rarity" },
        "anim": { "type": "object", "additionalProperties": false, "required": ["flight", "trail", "ability", "colors"], "description": "Launch, flight and ability animation (battle/weaponAnim.ts): flight look, trail kind, ability move and palette colours (Mash32 chars).", "properties": { "flight": { "enum": ["spin", "point", "tumble", "rock", "pulse", "aim", "flip", "frisbee", "corkscrew", "twirl", "windmill"] }, "trail": { "enum": ["ghost", "sparks", "none"] }, "ability": { "enum": ["slash", "charge", "slam", "recoil", "burst"] }, "colors": { "type": "array", "minItems": 1, "maxItems": 4, "items": { "type": "string", "pattern": "^[0-9a-v]$" } } } },
        "baseDamage": { "type": "number", "exclusiveMinimum": 0 },
        "unlock": {
          "type": ["string", "object"],
          "description": "'start', 'level N', or { boss, chest, shop }.",
          "properties": {
            "boss": { "type": "string" },
            "chest": { "type": "string" },
            "shop": { "type": "boolean" },
            "level": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        },
        "price": { "type": "number", "minimum": 0 },
        "launch": { "type": "string" },
        "sprite": { "type": "string", "description": "Path (no extension) of generated art under public/, e.g. sprites/relics/w_x: <path>.png and <path>_card.png" },
        "extraSprites": { "type": "array", "items": { "type": "string" }, "description": "More generated art paths (no extension); each loads as <file name> texture key" },
        "tap": { "type": "string" },
        "display": {
          "type": "object", "additionalProperties": false,
          "description": "Optional flight size override in world px for long items such as arrows.",
          "properties": { "px": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "enabled": { "type": "boolean", "description": "false hides it from shop and loadout without deleting it." },
        "physics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "radius": { "type": "number", "exclusiveMinimum": 0 },
            "density": { "type": "number", "exclusiveMinimum": 0 },
            "spin": { "type": "number" },
            "gravity": { "type": "number", "minimum": 0, "description": "1 = normal, below 1 floaty, above 1 drops fast, 0 none." },
            "tempo": { "type": "number", "minimum": 0.5, "maximum": 1.6, "description": "Flight speed: launch speed times tempo, gravity times tempo squared, so the shot lands where it would at 1 but gets there slower (below 1) or faster (above 1)." },
            "align": { "type": "boolean", "description": "Rotate to face the direction of travel." },
            "friction": { "type": "number", "minimum": 0 },
            "restitution": { "type": "number", "minimum": 0, "maximum": 1 },
            "frictionAir": { "type": "number", "minimum": 0 }
          }
        },
        "ability": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["button", "impact", "both", "none"] },
            "label": { "type": "string", "maxLength": 6 },
            "charges": { "type": "integer", "minimum": 1 }
          }
        },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "weaponStub": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": true,
      "properties": { "id": { "type": "string", "pattern": "^w_[a-z0-9_]+$" } }
    },
    "artifact": {
      "type": "object",
      "required": ["id", "name", "effect"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^r_[a-z0-9_]+$" },
        "name": { "type": "string" },
        "rarity": { "$ref": "#/$defs/rarity" },
        "price": { "type": "number", "minimum": 0 },
        "effect": { "type": "string" },
        "enabled": { "type": "boolean" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "consumable": {
      "type": "object",
      "required": ["id", "name", "effect"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^c_[a-z0-9_]+$" },
        "name": { "type": "string" },
        "price": { "type": "number", "minimum": 0 },
        "effect": { "type": "string" },
        "targeted": { "type": "boolean", "description": "true if the player taps a spot or monster to use it." },
        "enabled": { "type": "boolean" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "monster": {
      "type": "object",
      "required": ["id", "name", "hp", "weak", "resist"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "hp": { "type": "number", "exclusiveMinimum": 0 },
        "weak": { "$ref": "#/$defs/elementOrNull" },
        "resist": { "$ref": "#/$defs/elementOrNull" },
        "behavior": { "type": "string", "description": "Behaviour registry key; defaults to the monster id, then 'basic'." },
        "sprite": { "type": "string", "description": "Generated art path under public/ without extension, e.g. sprites/monsters/frost_wolf" },
        "size": {
          "type": "object", "additionalProperties": false, "required": ["w", "h"],
          "properties": { "w": { "type": "number", "exclusiveMinimum": 0 }, "h": { "type": "number", "exclusiveMinimum": 0 } }
        },
        "density": { "type": "number", "exclusiveMinimum": 0 },
        "coins": { "type": "number", "minimum": 0 },
        "score": { "type": "number", "minimum": 0 },
        "boss": { "type": "boolean" },
        "flying": { "type": "boolean", "description": "True if monster flies above the ground." },
        "note": { "type": "string" },
        "params": { "$ref": "#/$defs/params" }
      }
    },
    "material": {
      "type": "object",
      "required": ["id", "hp", "weak"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "hp": { "type": "number", "exclusiveMinimum": 0 },
        "weak": { "$ref": "#/$defs/elementOrNull" },
        "density": { "type": "number", "exclusiveMinimum": 0 },
        "friction": { "type": "number", "minimum": 0 },
        "coins": { "type": "number", "minimum": 0 },
        "score": { "type": "number", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "realm": {
      "type": "object",
      "required": ["id", "levels", "monsters"],
      "additionalProperties": false,
      "patternProperties": { "^_": {} },
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string" },
        "levels": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
        "monsters": { "type": "array", "items": { "type": "string" } },
        "palette": { "type": "string" },
        "background": { "type": "string", "description": "Background generator key in src/art." },
        "music": { "type": "string" }
      }
    },
    "cosmetic": {
      "type": "object",
      "required": ["id", "name", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s_[a-z0-9_]+$" },
        "name": { "type": "string" },
        "kind": { "enum": ["sling_skin", "trail", "banner", "slot"] },
        "slot": { "type": "boolean", "description": "True if cosmetic grants an extra weapon slot." },
        "priceCoins": { "type": "number", "minimum": 0 },
        "priceBits": { "type": "number", "minimum": 0, "description": "RUN Bits price; needs the iap feature and a shop.config.json entry." },
        "reward": { "type": "string", "description": "e.g. 'daily_streak_7'." },
        "desc": { "type": "string" },
        "mods": {
          "type": "object",
          "properties": {
            "launchSpeedMult": { "type": "number", "minimum": 0 },
            "twinFraction": { "type": "number", "minimum": 0 },
            "twinDelaySteps": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      }
    },
    "arena": {
      "type": "object", "additionalProperties": false,
      "required": ["startCoins", "stakes", "slings", "boosts"],
      "properties": {
        "startCoins": { "type": "integer", "minimum": 0 },
        "stakes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 0 } },
        "slings": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "$ref": "#/$defs/arenaSling" } },
        "boosts": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/arenaBoost" } }
      }
    },
    "arenaSling": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "desc", "price", "skin", "mods"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "desc": { "type": "string", "minLength": 1 },
        "price": { "type": "integer", "minimum": 0 },
        "skin": { "type": ["string", "null"] },
        "mods": { "$ref": "#/$defs/arenaMods" }
      }
    },
    "arenaMods": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "launchSpeedMult": { "type": "number", "minimum": 0 },
        "twinFraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "twinDelaySteps": { "type": "integer", "minimum": 1 },
        "previewMult": { "type": "number", "minimum": 0 },
        "damageMult": { "type": "number", "minimum": 0 }
      }
    },
    "arenaBoost": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "desc", "mod", "perLevel", "prices"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "name": { "type": "string", "minLength": 1 },
        "desc": { "type": "string", "minLength": 1 },
        "mod": { "enum": ["damageMult", "launchSpeedMult", "previewMult"] },
        "perLevel": { "type": "number", "minimum": 0 },
        "prices": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "integer", "minimum": 0 } }
      }
    }
  }
}
