{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "config.schema.json",
  "title": "Monster Mash game settings",
  "description": "public/data/config.json: engine, display, camera and feature flags. Balance numbers go in content.json, not here.",
  "type": "object",
  "required": ["version", "features"],
  "additionalProperties": false,
  "patternProperties": { "^_": {} },
  "properties": {
    "$schema": { "type": "string" },
    "targets": {
      "type": "object", "description": "Per build target overrides (android = the Play Store app): features switched off, AdMob ad unit ids.",
      "patternProperties": { "^_": {} },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "features": { "type": "object", "additionalProperties": { "type": "boolean" } },
          "admob": {
            "type": "object", "additionalProperties": false, "required": ["rewardedId", "interstitialId", "testing", "childRating", "teenRating"],
            "properties": {
              "rewardedId": { "type": "string", "pattern": "^ca-app-pub-[0-9]+/[0-9]+$" }, "interstitialId": { "type": "string", "pattern": "^ca-app-pub-[0-9]+/[0-9]+$" },
              "testing": { "type": "boolean", "description": "true = Google test ads (development); false only in the release build." },
              "childRating": { "enum": ["General", "ParentalGuidance", "Teen", "MatureAudience"], "description": "Max ad rating for players under 13 (age screen)." },
              "teenRating": { "enum": ["General", "ParentalGuidance", "Teen", "MatureAudience"], "description": "Max ad rating for players 13 and up." }
            }
          }
        }
      }
    },
    "version": { "type": "integer", "minimum": 1 },
    "practice": { "type": "object", "description": "Offline practice match (Handshake build): sample campaign levels, the same weapons for both sides, coin stakes, and how fast and how well the Rival Bot plays (botSkill 0 to 1).", "properties": { "levels": { "type": "array", "items": { "type": "integer" } }, "loadout": { "type": "array", "items": { "type": "string" } }, "stakes": { "type": "array", "items": { "type": "integer", "minimum": 0 } }, "startCoins": { "type": "integer", "minimum": 0 }, "botThinkMs": { "type": "integer", "minimum": 200 }, "botSkill": { "type": "number", "minimum": 0, "maximum": 1 } } },
    "links": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Web links the game can send players to (the jam vote page)." },
    "levels": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "description": "Ids of the level files in data/levels/ that the game loads. check-data keeps it in step with the folder." },
    "display": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 120 },
        "height": { "type": "integer", "minimum": 120 },
        "pixelArt": { "type": "boolean" },
        "androidMaxWidth": { "type": "integer", "minimum": 480, "description": "Maximum logical viewport width for the Android app; height remains 270." },
        "roundPixels": { "type": "boolean" },
        "maxParticles": { "type": "integer", "minimum": 0 },
        "ui": {
          "type": "object", "additionalProperties": false,
          "required": ["buttonCorner", "panelCorner", "iconPx", "iconGap", "buttonPadding", "disabledAlpha", "backdropAlpha", "plainPanelMinWidth", "plainPanelMinHeight", "listBackdropDimAlpha", "title"],
          "properties": {
            "buttonCorner": { "type": "integer", "minimum": 0 },
            "panelCorner": { "type": "integer", "minimum": 0 },
            "iconPx": { "type": "integer", "minimum": 1 },
            "iconGap": { "type": "integer", "minimum": 0 },
            "buttonPadding": { "type": "integer", "minimum": 0 },
            "disabledAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
            "backdropAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
            "plainPanelMinWidth": { "type": "integer", "minimum": 1 },
            "plainPanelMinHeight": { "type": "integer", "minimum": 1 },
            "listBackdropDimAlpha": { "type": "number", "minimum": 0, "maximum": 1 },
            "title": {
              "type": "object", "additionalProperties": false,
              "required": ["plateX", "plateY", "plateW", "insetX", "insetY", "rowGap", "emblemPx", "playH", "tileH", "tileGap", "tileRowH", "captionOffset", "tileIconPx", "utilityH", "utilityGap", "utilityPadding", "helpGap"],
              "properties": {
                "plateX": { "type": "integer", "minimum": 0 },
                "plateY": { "type": "integer", "minimum": 0 },
                "plateW": { "type": "integer", "minimum": 1 },
                "insetX": { "type": "integer", "minimum": 0 },
                "insetY": { "type": "integer", "minimum": 0 },
                "rowGap": { "type": "integer", "minimum": 0 },
                "emblemPx": { "type": "integer", "minimum": 1 },
                "playH": { "type": "integer", "minimum": 1 },
                "tileH": { "type": "integer", "minimum": 1 },
                "tileGap": { "type": "integer", "minimum": 0 },
                "tileRowH": { "type": "integer", "minimum": 1 },
                "captionOffset": { "type": "integer", "minimum": 0 },
                "tileIconPx": { "type": "integer", "minimum": 1 },
                "utilityH": { "type": "integer", "minimum": 1 },
                "utilityGap": { "type": "integer", "minimum": 0 },
                "utilityPadding": { "type": "integer", "minimum": 0 },
                "helpGap": { "type": "integer", "minimum": 0 }
              }
            }
          }
        },
        "weapon": {
          "type": "object", "additionalProperties": false,
          "description": "Drawn weapon size in world px: in flight, loaded on the sling, waiting in the queue. relicBonus scales 32 px relic art.",
          "properties": {
            "flightPx": { "type": "number", "exclusiveMinimum": 0 },
            "slingPx": { "type": "number", "exclusiveMinimum": 0 },
            "queuePx": { "type": "number", "exclusiveMinimum": 0 },
            "relicBonus": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "weaponAnim": {
          "type": "object", "additionalProperties": false,
          "description": "Code-drawn weapon launch and ability animation (battle/weaponAnim.ts): pop, punch and flash lengths in steps, sizes, spark counts, trail spacing (steps) and ghost fade (ms), tumble/rock/pulse amounts.",
          "properties": { "launchSteps": { "type": "number", "minimum": 0 }, "launchPop": { "type": "number", "minimum": 0 }, "launchSparks": { "type": "number", "minimum": 0 }, "abilitySteps": { "type": "number", "minimum": 0 }, "abilityPunch": { "type": "number", "minimum": 0 }, "abilityRing": { "type": "number", "minimum": 0 }, "abilitySparks": { "type": "number", "minimum": 0 }, "flashSteps": { "type": "number", "minimum": 0 }, "ghostAlpha": { "type": "number", "minimum": 0 }, "ghostMs": { "type": "number", "minimum": 0 }, "tumble": { "type": "number", "minimum": 0 }, "rock": { "type": "number", "minimum": 0 }, "rockSpeed": { "type": "number", "minimum": 0 }, "pulse": { "type": "number", "minimum": 0 }, "pulseSpeed": { "type": "number", "minimum": 0 }, "slashMs": { "type": "number", "minimum": 0 }, "kick": { "type": "number", "minimum": 0 }, "impactMinSpeed": { "type": "number", "minimum": 0 }, "impactSteps": { "type": "number", "minimum": 0 }, "impactSquash": { "type": "number", "minimum": 0 }, "aimTurn": { "type": "number", "minimum": 0 }, "flipSteps": { "type": "number", "minimum": 0 }, "flipTurns": { "type": "number", "minimum": 0 }, "flipLazy": { "type": "number", "minimum": 0 }, "frisbeeSpeed": { "type": "number", "minimum": 0 }, "corkSpeed": { "type": "number", "minimum": 0 }, "twirlSpeed": { "type": "number", "minimum": 0 }, "windmill": { "type": "number", "minimum": 0 }, "trailEvery": { "type": "integer", "minimum": 1 } }
        },
        "uiTextMin": { "type": "integer", "minimum": 4 }
      }
    },
    "world": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "groundY": { "type": "number" },
        "slingX": { "type": "number" },
        "slingY": { "type": "number" }
      }
    },
    "physics": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "stepHz": { "type": "integer", "minimum": 30, "maximum": 240 },
        "gravityY": { "type": "number" },
        "positionIterations": { "type": "integer", "minimum": 1 },
        "velocityIterations": { "type": "integer", "minimum": 1 },
        "enableSleeping": { "type": "boolean" },
        "maxStepsPerFrame": { "type": "integer", "minimum": 1 }
      }
    },
    "camera": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "introPan": { "type": "boolean" },
        "followShot": { "type": "boolean" },
        "minZoom": { "type": "number", "exclusiveMinimum": 0 },
        "maxZoom": { "type": "number", "exclusiveMinimum": 0 },
        "panMs": { "type": "integer", "minimum": 0 },
        "introMs": { "type": "integer", "minimum": 0, "description": "Intro pan out to the fort, ms." },
        "introHoldMs": { "type": "integer", "minimum": 0 },
        "toggleMs": { "type": "integer", "minimum": 0, "description": "View-all button tween." },
        "followLead": { "type": "number", "description": "Camera leads the shot by this fraction of the screen width." },
        "followEase": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "groundFrac": { "type": "number", "description": "Ground height on screen when zoomed in (0..1 of the height)." },
        "zoomOutRise": { "type": "number", "description": "How far the ground rises when zoomed out." }
      }
    },
    "features": {
      "type": "object",
      "description": "Every optional system is behind a flag so it can be cut or shipped independently.",
      "additionalProperties": { "type": "boolean" },
      "properties": {
        "map": { "type": "boolean" },
        "standResistance": { "type": "boolean", "description": "Firm footing for upright blocks in battle and builder Test." },
        "enemyWands": { "type": "boolean", "description": "Draw shooter wands; body-relative shot direction remains authoritative." },
        "burningVisuals": { "type": "boolean", "description": "Flames and embers on targets struck by fire or lightning; existing burn damage is unchanged." },
        "shop": { "type": "boolean" },
        "forge": { "type": "boolean" },
        "challenges": { "type": "boolean" },
        "artifacts": { "type": "boolean" },
        "consumables": { "type": "boolean" },
        "combo": { "type": "boolean" },
        "daily": { "type": "boolean" },
        "leaderboard": { "type": "boolean" },
        "share": { "type": "boolean" },
        "ads": { "type": "boolean" },
        "iap": { "type": "boolean" },
        "tutorial": { "type": "boolean" },
        "music": { "type": "boolean" },
        "zoom": { "type": "boolean" },
        "relics": { "type": "boolean" },
        "slingshots": { "type": "boolean" }
      }
    },
    "debug": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "urlOverrides": { "type": "boolean", "description": "Allow ?debug=1&tune.launchK=0.3 style overrides." },
        "testHook": { "type": "boolean", "description": "Expose window.__mm in dev and ?debug=1." }
      }
    }
  }
}
