rules_version = '2';

// Monster Smash: Siege Slingshot. Players sign in anonymously; everything below needs that sign-in.
// Names are generated by the app ("Brave Otter 482"); the rules only accept that shape, so no free text reaches other players
// except a level title (1 to 40 characters) on a shared level, which carries a Report button.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function validName(n) { return n is string && n.size() >= 5 && n.size() <= 24 && n.matches('^[A-Za-z]+ [A-Za-z]+ [0-9]{1,3}$'); }
    // The app sends its own clock in milliseconds; only recent times are accepted.
    function recent(t) { return t is int && t >= request.time.toMillis() - 600000 && t <= request.time.toMillis() + 600000; }
    function validTitle(t) { return t is string && t.size() >= 1 && t.size() <= 40; }
    function validJson(j) { return j is string && j.size() <= 60000; }

    // ---- score boards: boards/<board>/entries/<uid>, one best score per player
    match /boards/{board}/entries/{uid} {
      allow read: if signedIn();

      function shape() {
        return request.resource.data.keys().hasOnly(['name', 'score', 'updatedAt'])
          && request.resource.data.keys().hasAll(['name', 'score', 'updatedAt'])
          && validName(request.resource.data.name)
          && request.resource.data.score is int
          && request.resource.data.score > 0
          && request.resource.data.score <= 1000000
          && recent(request.resource.data.updatedAt);
      }

      allow create: if signedIn() && request.auth.uid == uid && board.matches('^[a-zA-Z0-9_-]{1,60}$') && shape();
      // only a better score replaces the old one
      allow update: if signedIn() && request.auth.uid == uid && shape() && request.resource.data.score > resource.data.score;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---- shared levels and challenge scores: ugc/<type>/items/<id>
    match /ugc/{type}/items/{id} {
      allow read: if signedIn();

      allow create: if signedIn() && type.matches('^[a-zA-Z0-9_-]{1,50}$')
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'title', 'json', 'uses', 'reports', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'title', 'json', 'uses', 'reports', 'createdAt', 'updatedAt'])
        && request.resource.data.authorId == request.auth.uid
        && validName(request.resource.data.authorName)
        && validTitle(request.resource.data.title)
        && validJson(request.resource.data.json)
        && request.resource.data.uses == 0
        && request.resource.data.reports == 0
        && recent(request.resource.data.createdAt)
        && recent(request.resource.data.updatedAt);

      allow update: if signedIn() && (
        // the author edits their own entry
        (resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'json', 'updatedAt'])
          && validTitle(request.resource.data.title)
          && validJson(request.resource.data.json)
          && recent(request.resource.data.updatedAt))
        // anyone counts one play
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
          && request.resource.data.uses == resource.data.uses + 1)
        // anyone who just filed a report (same batch) raises the report count by one
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
          && request.resource.data.reports == resource.data.reports + 1
          && existsAfter(/databases/$(database)/documents/ugc/$(type)/items/$(id)/reports/$(request.auth.uid))
          && !exists(/databases/$(database)/documents/ugc/$(type)/items/$(id)/reports/$(request.auth.uid)))
      );

      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // one report note per player, never readable by players (the owner reads them in the console)
      match /reports/{reporter} {
        allow read: if false;
        allow create: if signedIn() && request.auth.uid == reporter
          && request.resource.data.keys().hasOnly(['at'])
          && recent(request.resource.data.at);
      }
    }
  }
}
